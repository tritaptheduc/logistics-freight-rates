{
  "name": "Ocean Freight Comprehensive Theme",
  "dataColors": [
    "#059669",
    "#3B82F6",
    "#60A5FA",
    "#94A3B8",
    "#475569",
    "#0D9488",
    "#F59E0B"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#0F172A",
  "visualStyles": {
    "*": {
      "*": {
        "outspacePane": [{ "backgroundColor": { "solid": { "color": "#F8FAFC" } } }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E2E8F0" } }, "radius": 6 }],
        "dropShadow": [{ "show": true, "color": { "solid": { "color": "#000000" } }, "position": "Outer", "preset": "BottomRight", "transparency": 92 }],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Bold",
            "alignment": "Left"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1E293B" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#334155" } },
            "background": { "solid": { "color": "#FFFFFF" } }, "fontSize": 9.5
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#0F172A" } },
            "fontSize": 20,
            "fontFamily": "Segoe UI Bold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748B" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#334155" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "valueAxis": [
          {
            "show": false
          }
        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 8.5,
            "fontFamily": "Segoe UI Bold"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": { "solid": { "color": "#F1F5F9" } },
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#F1F5F9" } },
            "rowPadding": 3
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 9.5,
            "fontFamily": "Segoe UI Bold",
            "alignment": "Center"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1E293B" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#1E293B" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    }
  }
}